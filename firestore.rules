rules_version = '2';

// MyFit Firestore Security Rules (P10-1).
// 회장: Firebase 콘솔 > Firestore Database > 규칙 탭에 아래 전문을 붙여넣고 '게시'.
//
// 원칙(🔒CISO): 본인 uid 문서만 read/write. 인증 없는 접근·타인 문서 접근 전면 차단.
// 치수(숫자)만 저장하며 사진은 클라우드에 올리지 않는다(온디바이스 유지).
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 신체 치수 프로필: profiles/{uid}
    // 로그인한 본인(uid 일치)만 자기 문서를 읽고 쓸 수 있다.
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 그 외 모든 경로 기본 거부(명시적 deny-by-default).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
