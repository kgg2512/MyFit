{
  "name": "myfit-mobile",
  "version": "1.0.0",
  "description": "MyFit — 치수 기반 핏 예측 앱. 내 신체 치수 × 의류 실측 사이즈로 부위별 핏 예측.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:build:android": "npx cap sync android && cd android && ./gradlew bundleRelease",
    "build:all": "powershell -File build-all.ps1 -SkipAndroid",
    "build:web:demo": "powershell -File build-all.ps1 -Target web:demo",
    "build:web:prod": "powershell -File build-all.ps1 -Target web:prod",
    "build:android:demo": "powershell -File build-all.ps1 -Target android:demo",
    "build:android:prod": "powershell -File build-all.ps1 -Target android:prod"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/camera": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/status-bar": "^6.0.2",
    "firebase": "^12.16.0",
    "next": "^15.5.21",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
