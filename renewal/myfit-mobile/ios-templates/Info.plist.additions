<?xml version="1.0" encoding="UTF-8"?>
<!--
  MyFit — Info.plist Usage Description 추가 항목
-->
<plist version="1.0">
<dict>

  <!-- 카메라 (신체 피팅 사진 촬영) -->
  <key>NSCameraUsageDescription</key>
  <string>체형 프로필 사진 촬영에 사용됩니다. 사진은 기기 내에서만 처리되며 외부로 전송되지 않습니다.</string>

  <!-- 사진 라이브러리 읽기 -->
  <key>NSPhotoLibraryUsageDescription</key>
  <string>앨범에서 체형 프로필 사진을 선택합니다. 사진은 기기 내에서만 처리되며 외부로 전송되지 않습니다.</string>

  <!-- 앱 내 도메인 (CF Worker 프록시 도메인 추가) -->
  <key>WKAppBoundDomains</key>
  <array>
    <string>kgg2512.github.io</string>
  </array>

  <!-- 화면 방향 고정 -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>

</dict>
</plist>
